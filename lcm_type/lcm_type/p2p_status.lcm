package ctrl;

struct p2p_status_t
{
    double timestamp;
    int8_t mode;  // 0=hold, 1=track, 2=grav
    int32_t num_joints;
    int32_t num_arm;
    float q[num_joints];
    float q_des[num_joints];
    float qd[num_joints];
    float qd_des[num_joints];
    float kp[num_joints];
    float kd[num_joints];
    float fjc[num_joints];
    float friction_phi;
    float kp_scale;
    float kd_scale;
    float fjc_scale;
    boolean do_friction_comp;
    boolean do_grav_comp;
}
