  </asset>

  <default>
    <default class="rh_5_right">
      <geom friction="0.2" solref="0.02 1.5" solimp="0.9 0.99 0.001" conaffinity="3"/>
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0" density="0"/>
      </default>
      <default class="tip_collision">
        <geom type="capsule" fromto="0 0 0 0 0.0 0.032" friction="0.2 0.05 0.0002" size="0.012" group="3" conaffinity="3"/>
      </default>
      <default class="link_collision">
        <geom type="capsule" fromto="0 0 0 0 0.0 0.025" size="0.012" group="3" conaffinity="3" friction="0.2 0.05 0.0002"/>
      </default>
      <position kp="3.0" inheritrange="1"/>
      <!-- armature = rotor inertia * gear ratio^2 = 1.7 * 1e-8 * 288*288 = 0.00149376 -->
      <!-- max torque = 1.0 Nm (rated torque) -->
      <!-- frictionloss = rough guess, small ish value -->
      <joint damping="0.2" armature="0.00149376" actuatorfrcrange="-0.2 0.2" frictionloss="0.02"/>
    </default>
  </default>

  <!-- avoid consecutive links from contacting each other (because they penetrate each other)-->
