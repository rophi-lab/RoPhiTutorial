<mujoco model="table_mesh_cam">
  <compiler angle="radian" meshdir="../../object_mesh/" texturedir="../../object_mesh/"/>

  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-25"/>
  </visual>

  <default>
    <geom contype="1" conaffinity="1" friction="0.8 0.005 0.0001"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table" rgba="0.55 0.45 0.35 1" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3"/>
    <geom name="floor" type="plane" size="2 2 0.05" material="groundplane"/>

    <!-- Table top centered at z = 0.4, thickness 0.04 -->
    <geom name="table" type="box" size="0.4 0.4 0.02" pos="0 0 0.4"
          material="table" contype="1" conaffinity="1"/>

    <!-- Fixed RGB-D camera: diagonal overhead view of table center / bottle.
         MuJoCo cameras look along -Z; xyaxes set so -Z points at (0, 0, 0.45). -->
    <body name="upper_camera" pos="0.45 -0.45 1.15"
          xyaxes="0.7071 0.7071 0  -0.5232 0.5232 0.6727">
      <camera name="upper_camera" mode="fixed" pos="0 0 0" euler="0 0 0" fovy="55"/>
      <geom name="upper_camera_marker" type="box" size="0.03 0.01 0.015"
            rgba="0.15 0.15 0.15 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
